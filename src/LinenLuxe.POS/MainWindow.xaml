<Window x:Class="LinenLuxe.POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LinenLuxe.POS.ViewModels"
        xmlns:views="clr-namespace:LinenLuxe.POS.Views"
        mc:Ignorable="d"
        Title="LinenLuxe Laundry — Point of Sale"
        Height="760" Width="1040"
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource SansFont}">

    <!-- Each view model type renders with its matching view -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosShellViewModel}">
            <views:PosShellView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Active screen: login → home → the full POS shell -->
        <ContentControl Grid.Row="0" Content="{Binding Current}" />

        <!-- ============ Bottom status bar ============ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="20,14"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Left: database config status -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFE0574B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                        <Setter Property="Fill" Value="#FF57C77E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConfigStatus}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConfigDetail}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: signed-in user + version -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserStatus}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource GoldDeepBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

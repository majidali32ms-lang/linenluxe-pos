<UserControl x:Class="LinenLuxe.POS.Views.Sections.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Category / view filter chip -->
        <Style x:Key="ChipStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="txt" Text="{Binding}" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoldGradientBrush}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource NavyBrush}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same chip, but showing the option's label and its count -->
        <Style x:Key="ShownChipStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ChipStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" CornerRadius="14" Padding="14,6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="txt" Text="{Binding Label}" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoldGradientBrush}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource NavyBrush}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A price box in the list -->
        <Style x:Key="RateBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Width" Value="86" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Price list row -->
        <Style x:Key="PriceRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" Padding="16,7"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                                Opacity="{Binding RowOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="106" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <!-- Item name + category -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                               Opacity="0.75" />
                                </StackPanel>

                                <TextBox Grid.Column="1" Style="{StaticResource RateBox}"
                                         Text="{Binding CleanPress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Clean &amp; Press rate in AED. Leave empty if it is not offered." />

                                <TextBox Grid.Column="2" Style="{StaticResource RateBox}"
                                         Text="{Binding PressOnly, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Press Only rate in AED. Leave empty if it is not offered." />

                                <!-- In use / hidden -->
                                <CheckBox Grid.Column="3" IsChecked="{Binding IsActive}" Cursor="Hand"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ToolTip="Tick to offer this item on the New Order screen. Unticked hides it — it is never deleted, because orders already taken name it.">
                                    <CheckBox.Template>
                                        <!-- A tick box, not a label. Written as a pill with only
                                             a word in it, this read as a status someone had set
                                             elsewhere, and nobody thought to click it. -->
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="pill" CornerRadius="10" Padding="8,4"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="box" Width="13" Height="13" CornerRadius="3"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource TextSecondaryBrush}"
                                                            BorderThickness="1.2">
                                                        <TextBlock x:Name="tick" Text="&#xE73E;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                   Foreground="{StaticResource NavyBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    </Border>
                                                    <TextBlock x:Name="label" Text="Hidden" FontSize="10"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="label" Property="Text" Value="In use" />
                                                    <Setter TargetName="label" Property="Foreground"
                                                            Value="{StaticResource GoldDeepBrush}" />
                                                    <Setter TargetName="pill" Property="BorderBrush"
                                                            Value="{StaticResource GoldBrush}" />
                                                    <Setter TargetName="box" Property="Background"
                                                            Value="{StaticResource GoldGradientBrush}" />
                                                    <Setter TargetName="box" Property="BorderBrush"
                                                            Value="{StaticResource GoldBrush}" />
                                                    <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pill" Property="BorderBrush"
                                                            Value="{StaticResource GoldBrush}" />
                                                    <Setter TargetName="pill" Property="Background" Value="#1FC9A24B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#0AC9A24B" />
                            </Trigger>
                            <!-- A changed row is marked, so nothing is saved unnoticed -->
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#1FC9A24B" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter TargetName="row" Property="Background" Value="#18D14343" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="40,38,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Header + search ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Services &amp; Pricing" FontFamily="{StaticResource SerifFont}"
                               FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" />
                    <TextBlock Text="{Binding CountText}" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search the price list (Ctrl+F) — Esc clears" />
                    <TextBlock Text="Search items…  (Ctrl+F)" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" FontSize="14"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <Button Grid.Column="2" Style="{StaticResource GoldButton}" Content="+  New item"
                        Margin="8,0,0,0" Padding="14,9" VerticalAlignment="Center"
                        Command="{Binding NewItemCommand}"
                        ToolTip="Add something the price list does not have yet (Alt+N)" />
            </Grid>

            <Border Grid.Row="0" Height="1" Background="{StaticResource HairlineBrush}"
                    VerticalAlignment="Bottom" Margin="0,0,0,-22" />

            <!-- ============ Filters ============ -->
            <Grid Grid.Row="1" Margin="0,34,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ChipStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <ListBox Grid.Column="1" ItemsSource="{Binding Shown}" VerticalAlignment="Top"
                         SelectedItem="{Binding SelectedShown, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ShownChipStyle}"
                         Background="Transparent" BorderThickness="0" Margin="18,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <!-- ============ Column titles ============ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8,8,0,0" Padding="16,9"
                    Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="106" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ITEM" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}" />
                    <TextBlock Grid.Column="1" Text="CLEAN &amp; PRESS" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="PRESS ONLY" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="OFFERED?" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- ============ The price list ============ -->
            <Grid Grid.Row="3">
                <TextBlock Text="Loading the price list…" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,50,0,0"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="13.5"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="40,50,40,0" MaxWidth="520"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- A blank page reads as broken. Say which of the three it is. -->
                <StackPanel VerticalAlignment="Top" Margin="0,54,0,0" MaxWidth="380"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowNothingFound, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NothingFoundTitle}" FontSize="15" Margin="0,14,0,0"
                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NothingFoundDetail}" FontSize="12" Margin="0,7,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" Opacity="0.9"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <ListBox x:Name="PriceList" ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource PriceRowStyle}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,12"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- ============ Unsaved changes bar ============ -->
            <Border Grid.Row="4" Margin="0,0,0,16" CornerRadius="10" Padding="16,12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Not saved yet — press Save, or none of this happens"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="New rates change what the counter charges, and an item switched to Hidden leaves the New Order screen — both from the moment they are saved. Orders already taken keep the price they were sold at."
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ChangeProblem}" FontSize="11.5" Margin="0,5,0,0"
                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding HasChangeProblem, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Named for what it destroys, not for what it tidies. "Put back"
                             read as "apply", and pressing it threw the work away. -->
                        <Button Style="{StaticResource OutlineButton}" Content="Undo — don't save"
                                Padding="13,8" FontSize="12" Margin="0,0,8,0"
                                Command="{Binding DiscardCommand}"
                                ToolTip="Throw away every unsaved change on this screen and go back to the stored prices" />
                        <Button Style="{StaticResource GoldButton}" Content="{Binding SaveLabel}"
                                Padding="16,9" Command="{Binding SaveCommand}"
                                ToolTip="Save the changed rates (Ctrl+S)" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="{Binding Message}" FontSize="12" Margin="2,0,0,14"
                       Foreground="#FF1B6B3F" VerticalAlignment="Center"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />

            <!-- A write the database quietly ignored. Kept out of the load error,
                 which hides the list — here the list is the evidence. -->
            <Border Grid.Row="4" CornerRadius="10" Padding="14,11" Margin="0,0,0,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                    Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SaveError}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource ErrorBrush}" />
            </Border>
        </Grid>

        <!-- ==================== New item ==================== -->
        <Border Background="#99101B33"
                Visibility="{Binding IsAddingItem, Converter={StaticResource BoolToVis}}">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="14" Padding="26,22" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="New item" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               TextOptions.TextFormattingMode="Ideal" />
                    <TextBlock Text="It goes to the end of its category and is offered straight away."
                               FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" Margin="2,16,0,4" />
                    <ComboBox x:Name="NewCategoryBox" IsEditable="True" FontSize="13" Padding="9,6"
                              ItemsSource="{Binding CategoryChoices}"
                              Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Pick one it belongs in, or type a new one" />

                    <TextBlock Text="ITEM NAME" Style="{StaticResource FieldLabel}" Margin="2,12,0,4" />
                    <TextBox x:Name="NewNameBox" Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="CLEAN &amp; PRESS" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                            <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                     TextAlignment="Right"
                                     Text="{Binding NewCleanPress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="PRESS ONLY" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                            <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                     TextAlignment="Right"
                                     Text="{Binding NewPressOnly, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Leave a box empty if that service is not offered for this item — one of the two is enough."
                               FontSize="11" Margin="2,7,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="{Binding NewItemError}" FontSize="11.5" Margin="2,10,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                               Visibility="{Binding HasNewItemError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource OutlineButton}" Content="Cancel" Padding="13,8"
                                FontSize="12" Margin="0,0,8,0" Command="{Binding CancelNewItemCommand}" />
                        <Button Style="{StaticResource GoldButton}" Content="Add item" Padding="16,9"
                                Command="{Binding AddItemCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="LinenLuxe.POS.Views.Sections.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Filter chip -->
        <Style x:Key="ChipStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" CornerRadius="13" Padding="12,5"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="txt" Text="{Binding}" FontSize="11.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoldGradientBrush}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource NavyBrush}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A customer in the list -->
        <Style x:Key="CustomerRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                                Padding="13,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding PhoneDisplay, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding WhereDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <!-- Only NEW and REGULAR are worth the space; returning
                                         is what most customers are, and a badge on every row
                                         says nothing. -->
                                    <Border CornerRadius="9" Padding="8,3" Margin="0,0,5,0"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                            Visibility="{Binding StandingWorthShowing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding StandingBadge}" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldDeepBrush}" />
                                    </Border>
                                    <Border CornerRadius="9" Padding="8,3"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Badge}" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldDeepBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#14C9A24B" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One past order -->
        <Style x:Key="HistoryRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="0,7" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding OrderNumber}" MinWidth="66"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource GoldDeepBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CreatedDisplay}" FontSize="11"
                                           Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Border Grid.Column="2" CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" MinWidth="80"
                                           TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,30,34,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="330" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT: the list ==================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Customers" FontFamily="{StaticResource SerifFont}"
                           FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Text="{Binding CountText}" FontSize="13" Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Search + add -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" Padding="12,8"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name, phone or area (Ctrl+F) — Esc clears" />
                    <TextBlock Text="Name, phone or area…  (Ctrl+F)" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" FontSize="13"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="Refresh"
                        Margin="7,0,0,0" Padding="13,9" Command="{Binding RefreshCommand}"
                        ToolTip="Reload from the database (F5)" />
                <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Export"
                        Margin="6,0,0,0" Padding="13,9" Click="OnExport"
                        ToolTip="Save the list as it is shown here to a CSV file (Ctrl+E)" />
            </Grid>

            <!-- Filters + new -->
            <Grid Grid.Row="2" Margin="0,14,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding Filter, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ChipStyle}"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource OutlineButton}" Content="+  Walk-in"
                            Padding="11,6" FontSize="11.5" Margin="0,0,6,0"
                            Command="{Binding NewWalkInCommand}"
                            ToolTip="Add a counter customer (Alt+N)" />
                    <Button Style="{StaticResource GoldButton}" Content="+  Business"
                            Padding="12,7" FontSize="11.5"
                            Command="{Binding NewBusinessCommand}"
                            ToolTip="Add a hotel, salon or gym account (Alt+B)" />
                </StackPanel>
            </Grid>

            <!-- The list -->
            <Grid Grid.Row="3">
                <TextBlock Text="Loading customers…" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13.5" HorizontalAlignment="Center" Margin="0,40,0,0"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />

                <StackPanel VerticalAlignment="Top" Margin="0,44,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No customers here" FontSize="14" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Walk-ins added at the counter and website accounts both appear here."
                               FontSize="12" Margin="0,5,0,0" Opacity="0.8" MaxWidth="280"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- A list that could not load says so. Left as "no customers" it
                     would read as an answer, and staff would add someone twice. -->
                <Border CornerRadius="10" Padding="14,12" VerticalAlignment="Top" Margin="0,10,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                        Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LoadError}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Text="Check the internet connection, then press Refresh (F5)."
                                   FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="CustomerList" ItemsSource="{Binding Customers}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource CustomerRowStyle}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,16"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>

        <!-- ==================== RIGHT: details + history ==================== -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0"
                Margin="0,0,-34,0">
            <Grid>
                <!-- Nothing chosen -->
                <TextBlock Text="Choose a customer to see their details and orders."
                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelection}" Value="False" />
                                        <Condition Binding="{Binding IsCreating}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,26,24,20">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelection}" Value="False" />
                                            <Condition Binding="{Binding IsCreating}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding FormTitle}" FontFamily="{StaticResource SerifFont}"
                                   FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextOptions.TextFormattingMode="Ideal" />

                        <!-- A website account is shown, not edited -->
                        <Border CornerRadius="9" Padding="12,9" Margin="0,12,0,0"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding SelectedIsWebsite, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ReadOnlyReason}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Walk-in or business -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                    Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Which one is filled in is read from the view model and the
                                 click is sent back as a command, as on the New Order screen.
                                 A two-way binding here cannot work: FormIsWalkIn has no
                                 setter, and WPF throws rather than ignoring it. -->
                            <RadioButton GroupName="ctype" Content="Walk-in" Cursor="Hand" FontSize="12"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         IsChecked="{Binding FormIsWalkIn, Mode=OneWay}"
                                         Command="{Binding SetTypeCommand}" CommandParameter="walk_in" />
                            <RadioButton GroupName="ctype" Content="Business account" Cursor="Hand"
                                         FontSize="12" Margin="18,0,0,0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         IsChecked="{Binding FormIsBusiness, Mode=OneWay}"
                                         Command="{Binding SetTypeCommand}" CommandParameter="business" />
                        </StackPanel>

                        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}" />

                        <TextBlock Text="PHONE" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                 Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}" />

                        <TextBlock Text="EMAIL" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                 Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}" />

                        <!-- Business only -->
                        <StackPanel Visibility="{Binding FormIsBusiness, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CONTACT PERSON" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                     Text="{Binding FormContact, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditSelected}"
                                     ToolTip="Who to ask for when you ring" />
                        </StackPanel>

                        <TextBlock Text="AREA" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                 Text="{Binding FormArea, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}"
                                 ToolTip="Kept apart from the address so deliveries can be grouped by round" />

                        <TextBlock Text="ADDRESS" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                 MinHeight="52" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}" />

                        <!-- Business only -->
                        <StackPanel Visibility="{Binding FormIsBusiness, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="THEIR TRN" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13"
                                     Text="{Binding FormTrn, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditSelected}"
                                     ToolTip="The customer's own tax number, for their tax invoice — not the shop's" />

                            <TextBlock Text="DAYS TO PAY" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="13" Width="90"
                                     HorizontalAlignment="Left" TextAlignment="Right"
                                     Text="{Binding FormCreditDays, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditSelected}"
                                     ToolTip="0 means due on collection" />
                        </StackPanel>

                        <TextBlock Text="NOTES" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FieldBox}" Padding="11,7" FontSize="12.5"
                                 MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSelected}" />

                        <!-- Save -->
                        <StackPanel Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource GoldButton}" Margin="0,16,0,0" Padding="16,10"
                                    Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"
                                    ToolTip="Save this customer (Ctrl+S)" />
                            <Button Style="{StaticResource OutlineButton}" Margin="0,7,0,0" Padding="12,6"
                                    FontSize="11.5" HorizontalAlignment="Center" Content="Discard changes"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Message}" FontSize="12" Margin="2,10,0,0"
                                   Foreground="#FF1B6B3F" TextWrapping="Wrap"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Error}" FontSize="12" Margin="2,10,0,0"
                                   Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        <!-- ===== Same phone as someone else ===== -->
                        <Border CornerRadius="10" Padding="13,11" Margin="0,18,0,0"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DuplicateHeading}" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource GoldDeepBrush}" />
                                <TextBlock Text="{Binding DuplicateSummary}" FontSize="11.5" Margin="0,5,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                                <ItemsControl ItemsSource="{Binding Duplicates}" Margin="0,9,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <!-- The email is what tells two website
                                                         logins apart; the name alone cannot. -->
                                                    <TextBlock Text="{Binding WhereDisplay}" FontSize="10"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock FontSize="10" Margin="0,1,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Badge, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding OrderCount, Mode=OneWay}" />
                                                        <Run Text="orders" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Only offered for a record the POS owns; a
                                                     website account cannot be deleted from here. -->
                                                <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                                                        Content="Merge into this one" Padding="9,5" FontSize="10.5"
                                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ArmMergeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Asked once, in full, before anything is deleted -->
                                <Border CornerRadius="8" Padding="11,9" Margin="0,4,0,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                                        Visibility="{Binding IsMergePending, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MergeQuestion}" FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Button Style="{StaticResource GoldButton}" Content="Merge them"
                                                    Padding="12,6" FontSize="11.5"
                                                    Command="{Binding ConfirmMergeCommand}" />
                                            <Button Style="{StaticResource OutlineButton}" Content="Cancel"
                                                    Padding="12,6" FontSize="11.5" Margin="7,0,0,0"
                                                    Command="{Binding CancelMergeCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== Order history ===== -->
                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,20,0,14"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ORDER HISTORY" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldDeepBrush}" />
                            <TextBlock Text="{Binding StandingLine}" FontSize="12.5" Margin="0,5,0,0"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding HistorySummary}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <ListBox ItemsSource="{Binding History}"
                                     ItemContainerStyle="{StaticResource HistoryRowStyle}"
                                     Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                                     HorizontalContentAlignment="Stretch" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

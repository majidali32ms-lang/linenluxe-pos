<UserControl x:Class="LinenLuxe.POS.Views.Sections.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="760">

    <!-- Shown for screens that are not built yet -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">

        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="44"
                   Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Opacity="0.85" />

        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}"
                   FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,18,0,0"
                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" />

        <Border Background="#1FC9A24B" CornerRadius="12" Padding="12,4"
                HorizontalAlignment="Center" Margin="0,12,0,0"
                Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Shortcut}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldDeepBrush}" />
        </Border>

        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Margin="0,18,0,0" />

        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="70,22,70,0" />

        <TextBlock Text="{Binding Note}" FontSize="12.5" FontStyle="Italic"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   Margin="0,18,0,0" Opacity="0.8" />
    </StackPanel>
</UserControl>

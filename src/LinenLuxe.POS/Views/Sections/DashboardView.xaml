<UserControl x:Class="LinenLuxe.POS.Views.Sections.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="760">

    <UserControl.Resources>
        <!-- Big touch-friendly quick-action card -->
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Width" Value="210" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF8C7A55" BlurRadius="14" ShadowDepth="2"
                                                  Direction="270" Opacity="0.16" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0FC9A24B" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,38,40,32">

            <!-- Page header -->
            <TextBlock Text="{Binding Greeting}" FontFamily="{StaticResource SerifFont}"
                       FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding SubText}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />

            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,22,0,26" />

            <!-- Quick actions -->
            <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldDeepBrush}" Margin="2,0,0,16" />

            <WrapPanel>
                <!-- New Order -->
                <Button Style="{StaticResource ActionCard}" Command="{Binding NewOrderCommand}"
                        ToolTip="Create a new order (Ctrl+N)">
                    <StackPanel>
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Text="New Order" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" />
                        <TextBlock Text="Ctrl+N" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <!-- Orders -->
                <Button Style="{StaticResource ActionCard}" Command="{Binding OrdersCommand}"
                        ToolTip="Open the order queue (Ctrl+3)">
                    <StackPanel>
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Text="Orders" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" />
                        <TextBlock Text="Ctrl+3" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <!-- Customers -->
                <Button Style="{StaticResource ActionCard}" Command="{Binding CustomersCommand}"
                        ToolTip="Find a customer (Ctrl+4, or F2 to search by phone)">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Text="Customers" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" />
                        <TextBlock Text="Ctrl+4" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <!-- Services -->
                <Button Style="{StaticResource ActionCard}" Command="{Binding ServicesCommand}"
                        ToolTip="Browse the price list (Ctrl+5)">
                    <StackPanel>
                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Text="Services" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" />
                        <TextBlock Text="Ctrl+5" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Tip: press F1 any time to see all keyboard shortcuts."
                       FontSize="12.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="2,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

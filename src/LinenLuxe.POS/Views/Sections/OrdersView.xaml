<UserControl x:Class="LinenLuxe.POS.Views.Sections.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Status filter chip. Same shape as the New Order and Services chips;
             they each keep their own copy so a tweak to one screen can't quietly
             re-style the others. -->
        <Style x:Key="ChipStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" CornerRadius="14" Padding="13,5"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="txt" Text="{Binding}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoldGradientBrush}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource NavyBrush}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One placed order -->
        <Style x:Key="OrderRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="{StaticResource SurfaceBrush}" CornerRadius="11"
                                Padding="16,12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Order number: the thing staff and customer both say out loud -->
                                <TextBlock Grid.Column="0" Text="{Binding OrderNumber}"
                                           FontSize="15" FontWeight="Bold" MinWidth="76"
                                           Foreground="{StaticResource GoldDeepBrush}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                    <TextBlock Text="{Binding CustomerName}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding PhoneDisplay, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding CreatedDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Badges: status, express, payment method, paid state -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                    <!-- Where the order has reached. Colour-coded so the
                                         queue can be read without reading every word. -->
                                    <Border CornerRadius="9" Padding="9,3" Margin="0,0,6,0"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>

                                    <Border CornerRadius="9" Padding="8,3" Margin="0,0,6,0"
                                            Background="#1FC9A24B"
                                            Visibility="{Binding IsExpress, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="EXPRESS" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldDeepBrush}" />
                                    </Border>

                                    <Border CornerRadius="9" Padding="8,3" Margin="0,0,6,0"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding PaymentDisplay}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>

                                    <Border CornerRadius="9" Padding="8,3" Background="#1F2E9E5B"
                                            Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="PAID" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="#FF1B6B3F" />
                                    </Border>
                                    <Border CornerRadius="9" Padding="8,3" Background="#22B3261E"
                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="PENDING" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}"
                                           FontSize="14.5" FontWeight="Bold" MinWidth="96"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#14C9A24B" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,38,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- header + search -->
            <RowDefinition Height="Auto" />
            <!-- status chips + advance/back -->
            <RowDefinition Height="Auto" />
            <!-- hint -->
            <RowDefinition Height="*" />
            <!-- the list -->
        </Grid.RowDefinitions>

        <!-- ============ Header + search ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Orders" FontFamily="{StaticResource SerifFont}"
                           FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Text="{Binding CountText}" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="280">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Order number, name or phone (Ctrl+F) — Esc clears" />
                    <TextBlock Text="Order no, name or phone…  (Ctrl+F)" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" FontSize="14"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Button Style="{StaticResource OutlineButton}" Content="Invoice" Margin="8,0,0,0"
                        Padding="14,10" Command="{Binding PrintCommand}"
                        ToolTip="Print the A4 invoice for the highlighted order (Ctrl+P)" />
                <Button Style="{StaticResource OutlineButton}" Content="Receipt" Margin="6,0,0,0"
                        Padding="14,10" Command="{Binding PrintReceiptCommand}"
                        ToolTip="Print the 80mm till receipt for the highlighted order (Ctrl+R)" />
                <Button Style="{StaticResource OutlineButton}" Content="Refresh" Margin="6,0,0,0"
                        Padding="14,10" Command="{Binding RefreshCommand}"
                        ToolTip="Reload the list from the database (F5)" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" Background="{StaticResource HairlineBrush}"
                VerticalAlignment="Bottom" Margin="0,0,0,-22" />

        <!-- ============ Status filter + status controls ============ -->
        <Grid Grid.Row="1" Margin="0,34,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding StatusFilters}"
                     SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ChipStyle}"
                     Background="Transparent" BorderThickness="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Move the highlighted order along the lifecycle. The labels name the
                 step they move TO, so nobody has to remember the running order. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="12,0,0,0">
                <Button Style="{StaticResource OutlineButton}" Content="{Binding RewindLabel}"
                        Padding="12,6" FontSize="12" Margin="0,0,6,0"
                        Command="{Binding RewindStatusCommand}"
                        ToolTip="Move this order back one step (Ctrl+Left)" />
                <Button Style="{StaticResource GoldButton}" Content="{Binding AdvanceLabel}"
                        Padding="14,7" FontSize="12"
                        Command="{Binding AdvanceStatusCommand}"
                        ToolTip="Move this order on to the next step (Ctrl+Right)" />
            </StackPanel>
        </Grid>

        <!-- ============ Hint ============ -->
        <TextBlock Grid.Row="2" Margin="2,0,0,12" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Double-click an order to open it — it keeps the same invoice number." />

        <!-- ============ The list ============ -->
        <Grid Grid.Row="3">
            <TextBlock Text="Loading orders…" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,50,0,0"
                       Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="13.5"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="40,50,40,0" MaxWidth="520"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel VerticalAlignment="Top" Margin="0,60,0,0" HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                           Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"
                           HorizontalAlignment="Center" />
                <TextBlock Text="No orders yet" FontSize="15" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Orders saved on the New Order screen appear here."
                           FontSize="12.5" Margin="0,6,0,0" Opacity="0.8"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="OrderList" ItemsSource="{Binding Orders}"
                     SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource OrderRowStyle}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,0,20"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="OnOrderDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ToolTip="Double-click an order to open it, or highlight it and press Enter"
                     Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>

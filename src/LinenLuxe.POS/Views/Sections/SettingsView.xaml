<UserControl x:Class="LinenLuxe.POS.Views.Sections.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="760">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,38,40,40">

            <!-- Page header -->
            <TextBlock Text="Settings" FontFamily="{StaticResource SerifFont}"
                       FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" />
            <TextBlock Text="App preferences and the full keyboard shortcut reference."
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />

            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,22,0,26" />

            <!-- ===== Keyboard shortcuts ===== -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource GoldDeepBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Every action in the POS has a shortcut so staff can work without the mouse."
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,6,0,18" />

            <!-- Groups -->
            <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}"
                                           FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <!-- Rows: action on the left, keys on the right -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Action}"
                                                           FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Opacity="0.9" />
                                                <!-- Key cap -->
                                                <Border Grid.Column="1" Background="#1FC9A24B" CornerRadius="6"
                                                        Padding="10,3" BorderBrush="#40C9A24B" BorderThickness="1">
                                                    <TextBlock Text="{Binding Keys}" FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GoldDeepBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== About ===== -->
            <TextBlock Text="ABOUT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldDeepBrush}" Margin="2,14,0,10" />
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" Opacity="0.9">
                        <Run Text="LinenLuxe POS" FontWeight="SemiBold" />
                        <Run Text="  ·  " Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource GoldDeepBrush}" />
                    </TextBlock>
                    <TextBlock Text="Shares the same database as the LinenLuxe web app and customer PWA."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

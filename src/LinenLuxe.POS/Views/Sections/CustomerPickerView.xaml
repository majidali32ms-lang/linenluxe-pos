<UserControl x:Class="LinenLuxe.POS.Views.Sections.CustomerPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- A found customer -->
        <Style x:Key="CustomerRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14,11"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PhoneDisplay}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <!-- WEBSITE / WALK-IN badge -->
                                <Border Grid.Column="1" CornerRadius="9" Padding="8,3" VerticalAlignment="Center"
                                        Background="#1FC9A24B">
                                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource GoldDeepBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#1FC9A24B" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Dim the screen behind the dialog -->
    <Grid Background="#590A1A3A">
        <Border Style="{StaticResource Card}" Width="520" MaxHeight="600"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="16" Padding="26,22">
            <Border.Effect>
                <DropShadowEffect Color="#FF0A1A3A" BlurRadius="40" ShadowDepth="0" Opacity="0.28" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Select Customer" FontFamily="{StaticResource SerifFont}"
                                   FontSize="23" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Search by phone or name — website customers and walk-ins"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="Esc to close" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7" />
                </Grid>

                <!-- Search -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Phone number or name, then Enter" />
                        <TextBlock Text="Phone or name…" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" FontSize="14"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource GoldButton}" Content="Search"
                            Margin="8,0,0,0" Padding="20,10" Command="{Binding SearchCommand}"
                            IsDefault="False" ToolTip="Search (Enter)" />
                </Grid>

                <!-- A first-time visitor is not findable by definition, so adding
                     one must not be hidden behind a search that comes back empty. -->
                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="13,7" FontSize="12"
                        Content="+   New customer   ·   Alt+N"
                        Command="{Binding NewCustomerCommand}"
                        ToolTip="Add someone who has never been to the shop before (Alt+N)" />
                </StackPanel>

                <!-- Results / add walk-in -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Searching…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CustomerRowStyle}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="OnResultDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}" />

                    <!-- New walk-in: opened by the button, or offered automatically
                         when a search finds nobody.

                         It scrolls on its own. The dialog is capped at MaxHeight, so
                         without this the last control in the form is simply clipped
                         off the bottom edge once the window gets short. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0"
                                  Visibility="{Binding ShowWalkInForm, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="12" Padding="16,14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding WalkInHeading}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource GoldDeepBrush}" />
                            <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" Margin="2,10,0,5" />
                            <TextBox x:Name="NewNameBox" Style="{StaticResource FieldBox}" Padding="12,7"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Customer's name, then Enter to save" />
                            <TextBlock Text="PHONE (optional)" Style="{StaticResource FieldLabel}" Margin="2,9,0,5" />
                            <TextBox x:Name="NewPhoneBox" Style="{StaticResource FieldBox}" Padding="12,7"
                                     Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Phone number, then Enter to save" />
                            <Button Style="{StaticResource GoldButton}" Margin="0,12,0,0" Padding="18,10"
                                    Content="Save customer &amp; use for this order   ·   Alt+S"
                                    Command="{Binding AddWalkInCommand}"
                                    ToolTip="Save this customer and use them for the order (Alt+S, or Enter in either field)" />

                            <Button Style="{StaticResource OutlineButton}" Margin="0,7,0,0"
                                    Padding="10,5" FontSize="11.5" HorizontalAlignment="Center"
                                    Content="&#x2190;  Back to search   ·   Esc"
                                    Command="{Binding BackToSearchCommand}"
                                    ToolTip="Return to searching (Esc)"
                                    Visibility="{Binding ShowNewForm, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <Grid>
                        <Button Style="{StaticResource OutlineButton}" Content="Cancel"
                                HorizontalAlignment="Left" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource GoldButton}" Content="Use this customer"
                                HorizontalAlignment="Right" Padding="18,10"
                                Command="{Binding ChooseCommand}"
                                ToolTip="Attach the highlighted customer to this order (Enter)" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="LinenLuxe.POS.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Print preview"
        Height="820" Width="720"
        MinHeight="500" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource SansFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What am I looking at -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,14"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource SerifFont}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextOptions.TextFormattingMode="Ideal" />
                <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- The pages, exactly as they will print -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="PageList" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,18" Background="White"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF8C7A55" BlurRadius="16" ShadowDepth="3"
                                                  Direction="270" Opacity="0.2" />
                            </Border.Effect>
                            <Image Source="{Binding}" Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="20,14"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="PageCountText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButton}" Content="Save as PDF"
                            Padding="14,9" Margin="0,0,8,0" Click="OnSavePdf"
                            ToolTip="Save this document as a PDF file instead of printing it" />
                    <Button Style="{StaticResource OutlineButton}" Content="Close"
                            Padding="14,9" Margin="0,0,8,0" IsCancel="True" />
                    <Button Style="{StaticResource GoldButton}" Content="Print…"
                            Padding="20,10" Click="OnPrint" IsDefault="True"
                            ToolTip="Choose a printer and print (Enter)" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

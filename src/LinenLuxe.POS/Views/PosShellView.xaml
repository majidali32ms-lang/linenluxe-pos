<UserControl x:Class="LinenLuxe.POS.Views.PosShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sec="clr-namespace:LinenLuxe.POS.ViewModels.Sections"
             xmlns:secv="clr-namespace:LinenLuxe.POS.Views.Sections"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="1000"
             Focusable="True">

    <UserControl.Resources>
        <!-- Each section view model renders with its matching view -->
        <DataTemplate DataType="{x:Type sec:DashboardViewModel}">
            <secv:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:PlaceholderViewModel}">
            <secv:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:SettingsViewModel}">
            <secv:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:ServicesViewModel}">
            <secv:ServicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:OrdersViewModel}">
            <secv:OrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:CustomersViewModel}">
            <secv:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sec:NewOrderViewModel}">
            <secv:NewOrderView />
        </DataTemplate>

        <!-- Sidebar nav item: icon + title + shortcut hint, gold when active -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Grid.Column="0" Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" Margin="13,0,8,0"
                                           FontSize="14" Foreground="{StaticResource OffWhiteBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="hint" Grid.Column="2" Text="{Binding ShortcutHint}"
                                           FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1FC9A24B" />
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="hint" Property="Foreground" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ===== Global keyboard shortcuts (navigation) ===== -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateIndexCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateIndexCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateIndexCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateIndexCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateIndexCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateIndexCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NavigateCommand}" CommandParameter="new-order" />
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding SignOutCommand}" />
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding FocusSearchCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource NavyGradientBrush}"
                BorderBrush="#22C9A24B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="22,24,20,20">
                    <TextBlock FontFamily="{StaticResource SerifFont}" FontSize="27" FontWeight="Bold"
                               TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
                        <Run Text="Linen" Foreground="{StaticResource OffWhiteBrush}" /><Run Text="Luxe"
                             Foreground="{StaticResource GoldGradientBrush}" />
                    </TextBlock>
                    <TextBlock Text="POINT OF SALE" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldLightBrush}" Margin="1,3,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <!-- Signed-in user + sign out -->
                <Border Grid.Row="2" BorderBrush="#22C9A24B" BorderThickness="0,1,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="{StaticResource OffWhiteBrush}"
                                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ShowUserName, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding RoleBadge}" Foreground="{StaticResource GoldLightBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SidebarOutlineButton}"
                                Content="Sign out" Padding="11,7"
                                Command="{Binding SignOutCommand}"
                                ToolTip="Sign out of the POS (Ctrl+L)" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Top bar + active screen ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The top bar: where you are, one search that
                 finds an order or a customer, who is signed in, and the date. -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                    Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentSectionTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid Grid.Column="1" MaxWidth="380" HorizontalAlignment="Center">
                        <TextBox x:Name="GlobalSearchBox" Style="{StaticResource FieldBox}"
                                 Padding="12,7" FontSize="12.5"
                                 Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Find an order by number, or a customer by name or phone (Ctrl+K). Enter searches."
                                 KeyDown="OnGlobalSearchKeyDown" />
                        <TextBlock Text="Find an order or customer…   (Ctrl+K)" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"
                                   FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsGlobalSearchEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Today}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Border CornerRadius="9" Padding="10,4" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding SignedInAs}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource GoldDeepBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentSection}" />
        </Grid>
    </Grid>
</UserControl>

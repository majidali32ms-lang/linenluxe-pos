<!--
    LinenLuxe brand theme — single source of truth for colors, brushes and fonts.
    Every screen references these keys so the whole app stays visually consistent
    and future re-branding is a one-file change.

    The app follows the website: a warm off-white page with white cards, gold
    hairlines and navy serif headings. The sidebar stays navy — the same anchor
    the website's navbar gives the page.

    So there are TWO sets of text brushes:
      * light surfaces (every screen)  -> TextPrimary / TextSecondary / GoldDeep
      * the navy sidebar               -> OffWhite / Muted / GoldLight
    Picking the wrong set is the one way to make text invisible here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Brand colors ===== -->
    <Color x:Key="NavyColor">#FF0A1A3A</Color>
    <Color x:Key="NavyDeepColor">#FF06122A</Color>
    <Color x:Key="GoldColor">#FFC9A24B</Color>
    <Color x:Key="GoldLightColor">#FFF4D585</Color>
    <!-- Gold dark enough to read as small text on white -->
    <Color x:Key="GoldDeepColor">#FF9A7524</Color>
    <Color x:Key="OffWhiteColor">#FFFAF7F0</Color>
    <Color x:Key="InkColor">#FF3C3C3C</Color>
    <Color x:Key="MutedColor">#FFB9C0CE</Color>

    <!-- Light surfaces -->
    <Color x:Key="PageTopColor">#FFFEFDFB</Color>
    <Color x:Key="PageBottomColor">#FFF6F1E8</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFFAF6EE</Color>
    <Color x:Key="TextPrimaryColor">#FF0A1A3A</Color>
    <Color x:Key="TextSecondaryColor">#FF6E7280</Color>

    <!-- ===== Solid brushes ===== -->
    <SolidColorBrush x:Key="NavyBrush"      Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="GoldBrush"      Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="GoldDeepBrush"  Color="{StaticResource GoldDeepColor}" />
    <SolidColorBrush x:Key="OffWhiteBrush"  Color="{StaticResource OffWhiteColor}" />
    <SolidColorBrush x:Key="InkBrush"       Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush"     Color="{StaticResource MutedColor}" />

    <!-- Light-surface set -->
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <!-- Gold at low opacity: card edges, dividers, row separators -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE6DAC0" />
    <SolidColorBrush x:Key="HairlineBrush"   Color="#FFEDE4D2" />
    <!-- Error text that stays readable on white -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFB3261E" />

    <!-- Warm off-white page background (the whole app sits on this) -->
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageTopColor}"    Offset="0" />
        <GradientStop Color="{StaticResource PageBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Navy vertical gradient — the sidebar -->
    <LinearGradientBrush x:Key="NavyGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NavyColor}"     Offset="0" />
        <GradientStop Color="{StaticResource NavyDeepColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Typography ===== -->
    <!-- Serif for headings (elegant, ships with Windows). We can embed Playfair/
         Cormorant later for an exact match to the website. -->
    <FontFamily x:Key="SerifFont">Georgia, 'Times New Roman', serif</FontFamily>
    <!-- Clean sans-serif for body text and numbers -->
    <FontFamily x:Key="SansFont">Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Gold gradient used on primary buttons and the "Luxe" word -->
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6DE9A" Offset="0" />
        <GradientStop Color="#FFC9A24B" Offset="0.55" />
        <GradientStop Color="#FFB8902F" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Form field label ===== -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldDeepBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <!-- ===== Text input (white field with a gold focus edge) ===== -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource GoldDeepBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same look for PasswordBox -->
    <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource GoldDeepBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Primary gold button (large, touch-friendly) ===== -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GoldGradientBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Subtle outline button on a light surface (Clear, Cancel) ===== -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GoldDeepBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#14C9A24B" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Same button, but for the navy sidebar (Sign out) ===== -->
    <Style x:Key="SidebarOutlineButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="#66C9A24B" BorderThickness="1" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#22C9A24B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Card: white panel with a gold hairline (matches the website) ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

</ResourceDictionary>

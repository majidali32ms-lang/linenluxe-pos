# LinenLuxe POS — environment template.
# Copy this file to ".env" and fill in the real values (the real .env is gitignored).
#
# Use the SAME Supabase project as the web app so the desktop POS and the
# website share the same customers, orders and pricing data.
# The publishable key is safe for client apps (the database is protected by
# Row Level Security). Do NOT put server-only secrets (e.g. Resend) here.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
